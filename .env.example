# Copy this to .env.development and fill in real values.
# See the README's "Environment variables" section for what each one does
# and where to get it. Nothing below is a real secret.

# ── Required ──────────────────────────────────────────────────────────
# Atlas: create a free cluster, add a db user, allow your IP, then
# "Connect" → "Drivers" gives you this string.
MONGO_URI=

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=

CLIENT_URL=http://localhost:3001

# ── Commonly set ──────────────────────────────────────────────────────
PORT=3000

# Falls back to JWT_SECRET if left blank.
REFRESH_TOKEN_SECRET=

BACKEND_INTERNAL_URL=http://localhost:3000

# Free account at cloudinary.com — Name/Key/Secret are on your dashboard's
# API Keys page. Without these, uploads are just disabled in dev.
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# resend.com — API key from their dashboard. Without it the contact form
# just fails to send.
RESEND_API_KEY=

# ── Feature-specific, safe to leave blank ─────────────────────────────
# Only needed to actually execute Java/Python submissions on /coding.
# JS problems always run fine in-browser without this.
PISTON_URL=
PISTON_TOKEN=
PISTON_CA_CERT=

LEADERBOARD_MAX_AGE_DAYS=30
TEST_USER_TTL_MINUTES=60
VITE_BACKEND_URL=

# Only needed for scripts/encrypt-report.mjs and the /performance route.
AUDIT_PASSWORD=

# Legacy admin stats widget from before the move to Azure. Safe to ignore.
DO_API_TOKEN=
UPTIMEROBOT_API_KEY=
